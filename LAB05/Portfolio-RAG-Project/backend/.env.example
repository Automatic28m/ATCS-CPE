# ==========================================
# RAG Backend Environment Variables
# ==========================================

# Groq API Key (Required if LLM_PROVIDER is set to "groq" in config.py)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Hugging Face Token (Optional but highly recommended)
# Prevents rate limits and faster downloads for Embedding and Reranker models.
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here
